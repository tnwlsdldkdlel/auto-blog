# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright persistent user data (네이버 로그인 세션 저장소)
/.playwright-user-data/

# claude code runtime artifacts
.claude/scheduled_tasks.lock

# docs (PRD 등 로컬 기획 문서)
/docs/

# 셀렉터 진단 디버그 스크린샷 (verify-*.mjs / inspect-*.mjs)
/scripts/*.png
